{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "@effect/language-service",
        // Chat timestamps are rendered with Date, as the web app already does.
        "diagnosticSeverity": {
          "globalDate": "off"
        }
      }
    ]
  },
  "include": ["src"]
}
