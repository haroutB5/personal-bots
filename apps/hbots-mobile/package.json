{
  "name": "@hbots/mobile",
  "version": "1.66.110",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "prebuild": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform android",
    "release": "cd android && ./gradlew assembleRelease",
