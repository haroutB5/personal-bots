<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/hbots_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/hbots_widget_bg"
  android:orientation="vertical"
  android:padding="14dp">

  <TextView
    android:id="@+id/hbots_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textColor="#FFC9C9C5"
    android:textSize="13sp"
    android:textStyle="bold"/>

  <TextView
    android:id="@+id/hbots_message"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:gravity="center_vertical"
    android:textColor="#FFF2F2EF"
    android:textSize="16sp"
    android:visibility="gone"/>

  <LinearLayout
    android:id="@+id/hbots_row1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">
    <ImageView
      android:id="@+id/hbots_dot1"
      android:layout_width="10dp"
      android:layout_height="10dp"
      android:importantForAccessibility="no"
      android:src="@drawable/hbots_dot_idle"/>
    <TextView
      android:id="@+id/hbots_name1"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#FFF2F2EF"
      android:textSize="15sp"/>
  </LinearLayout>
  <LinearLayout
    android:id="@+id/hbots_row2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">
    <ImageView
      android:id="@+id/hbots_dot2"
      android:layout_width="10dp"
      android:layout_height="10dp"
      android:importantForAccessibility="no"
      android:src="@drawable/hbots_dot_idle"/>
    <TextView
      android:id="@+id/hbots_name2"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#FFF2F2EF"
      android:textSize="15sp"/>
  </LinearLayout>
  <LinearLayout
    android:id="@+id/hbots_row3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">
    <ImageView
      android:id="@+id/hbots_dot3"
      android:layout_width="10dp"
      android:layout_height="10dp"
      android:importantForAccessibility="no"
      android:src="@drawable/hbots_dot_idle"/>
    <TextView
      android:id="@+id/hbots_name3"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#FFF2F2EF"
      android:textSize="15sp"/>
  </LinearLayout>
  <LinearLayout
    android:id="@+id/hbots_row4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">
    <ImageView
      android:id="@+id/hbots_dot4"
      android:layout_width="10dp"
      android:layout_height="10dp"
      android:importantForAccessibility="no"
      android:src="@drawable/hbots_dot_idle"/>
    <TextView
      android:id="@+id/hbots_name4"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#FFF2F2EF"
      android:textSize="15sp"/>
  </LinearLayout>
  <LinearLayout
    android:id="@+id/hbots_row5"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">
    <ImageView
      android:id="@+id/hbots_dot5"
      android:layout_width="10dp"
      android:layout_height="10dp"
      android:importantForAccessibility="no"
      android:src="@drawable/hbots_dot_idle"/>
    <TextView
      android:id="@+id/hbots_name5"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#FFF2F2EF"
      android:textSize="15sp"/>
  </LinearLayout>

  <TextView
    android:id="@+id/hbots_more"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textColor="#FFC9C9C5"
    android:textSize="12sp"
    android:visibility="gone"/>
</LinearLayout>
