<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/hbots_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/hbots_widget_bg"
  android:orientation="vertical"
  android:padding="12dp">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
  <FrameLayout
    android:layout_width="36dp"
    android:layout_height="36dp">
    <ImageView
      android:id="@+id/hbots_face_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:src="@drawable/hbots_avatar"/>
    <TextView
      android:id="@+id/hbots_face_text"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:importantForAccessibility="no"
      android:textColor="#FFFFFFFF"
      android:textSize="15sp"
      android:textStyle="bold"/>
  </FrameLayout>
  <TextView
    android:id="@+id/hbots_name"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FFF2F2EF"
    android:textSize="15sp"
    android:layout_marginStart="8dp"
    android:layout_weight="1"
    android:textStyle="bold"/>
  </LinearLayout>
  <TextView
    android:id="@+id/hbots_sub"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:ellipsize="end"
    android:maxLines="3"
    android:textColor="#FFF2F2EF"
    android:textSize="13sp"
    android:layout_marginTop="6dp"
    android:layout_weight="1"
    android:gravity="top"/>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView
      android:id="@+id/hbots_dot"
      android:layout_width="10dp"
      android:layout_height="10dp"
      android:importantForAccessibility="no"
      android:src="@drawable/hbots_dot_idle"/>
  <TextView
    android:id="@+id/hbots_status"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FFC9C9C5"
    android:textSize="12sp"
    android:layout_marginStart="6dp"
    android:layout_weight="1"/>
  </LinearLayout>
  <TextView
    android:id="@+id/hbots_side"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FF8C8C88"
    android:textSize="11sp"
    android:visibility="gone"/>
</LinearLayout>
