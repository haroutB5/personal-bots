<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/hbots_item"
  android:layout_width="match_parent"
  android:layout_height="20dp"
  android:gravity="center_vertical"
  android:orientation="horizontal">
  <TextView
    android:id="@+id/hbots_label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FF8C8C88"
    android:textSize="11sp"
    android:minWidth="34dp"/>
  <ProgressBar
    android:id="@+id/hbots_bar"
    style="@android:style/Widget.ProgressBar.Horizontal"
    android:layout_width="0dp"
    android:layout_height="6dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_weight="1"
    android:importantForAccessibility="no"
    android:max="100"
    android:progressDrawable="@drawable/hbots_progress_hot"/>
  <TextView
    android:id="@+id/hbots_value"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FFF5B14A"
    android:textSize="11sp"
    android:minWidth="30dp"
    android:gravity="end"/>
</LinearLayout>
