<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/hbots_item"
  android:layout_width="match_parent"
  android:layout_height="48dp"
  android:gravity="center_vertical"
  android:orientation="horizontal">
  <FrameLayout
    android:layout_width="32dp"
    android:layout_height="32dp">
    <ImageView
      android:id="@+id/hbots_face_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:src="@drawable/hbots_avatar"/>
    <TextView
      android:id="@+id/hbots_face_text"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:importantForAccessibility="no"
      android:textColor="#FFFFFFFF"
      android:textSize="14sp"
      android:textStyle="bold"/>
  </FrameLayout>
  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_weight="1"
    android:orientation="vertical">
  <TextView
    android:id="@+id/hbots_name"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FFF2F2EF"
    android:textSize="15sp"/>
  <TextView
    android:id="@+id/hbots_sub"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FF8C8C88"
    android:textSize="12sp"/>
  </LinearLayout>
  <TextView
    android:id="@+id/hbots_time"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FF8C8C88"
    android:textSize="12sp"
    android:layout_marginStart="8dp"/>
  <ImageView
    android:id="@+id/hbots_dot"
    android:layout_width="10dp"
    android:layout_height="10dp"
    android:layout_marginStart="8dp"
    android:importantForAccessibility="no"
    android:src="@drawable/hbots_dot_idle"/>
</LinearLayout>
