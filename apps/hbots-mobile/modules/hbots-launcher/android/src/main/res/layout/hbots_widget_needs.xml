<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/hbots_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/hbots_widget_bg"
  android:orientation="vertical"
  android:padding="12dp">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="4dp">
  <TextView
    android:id="@+id/hbots_title"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FFC9C9C5"
    android:textSize="13sp"
    android:layout_weight="1"
    android:textStyle="bold"/>
  <TextView
    android:id="@+id/hbots_side"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FF8C8C88"
    android:textSize="12sp"
    android:layout_marginStart="8dp"/>
  </LinearLayout>
  <LinearLayout
    android:id="@+id/hbots_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/hbots_card"
    android:orientation="vertical"
    android:padding="10dp"
    android:visibility="gone">
  <TextView
    android:id="@+id/hbots_meta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FFF5B14A"
    android:textSize="11sp"/>
  <TextView
    android:id="@+id/hbots_question"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="3"
    android:textColor="#FFF2F2EF"
    android:textSize="14sp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="6dp"/>
  <LinearLayout
    android:id="@+id/hbots_choices"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"/>
  </LinearLayout>
  <LinearLayout
    android:id="@+id/hbots_rows"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"/>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="bottom"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/hbots_ask"
      android:layout_width="0dp"
      android:layout_height="44dp"
      android:layout_weight="1"
      android:background="@drawable/hbots_pill"
      android:contentDescription="@string/hbots_new_chat"
      android:gravity="center_vertical"
      android:paddingStart="16dp"
      android:text="@string/hbots_new_chat"
      android:textColor="#FFF2F2EF"
      android:textSize="14sp"/>
    <ImageView
      android:id="@+id/hbots_voice"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:layout_marginStart="6dp"
      android:background="@drawable/hbots_pill"
      android:contentDescription="@string/hbots_voice"
      android:padding="10dp"
      android:src="@drawable/hbots_ic_mic"/>
    <ImageView
      android:id="@+id/hbots_photo"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:layout_marginStart="6dp"
      android:background="@drawable/hbots_pill"
      android:contentDescription="@string/hbots_photo"
      android:padding="10dp"
      android:src="@drawable/hbots_ic_camera"/>
  </LinearLayout>
</LinearLayout>
