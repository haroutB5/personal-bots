<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/hbots_item"
  android:layout_width="0dp"
  android:layout_height="wrap_content"
  android:layout_margin="3dp"
  android:layout_weight="1"
  android:background="@drawable/hbots_card"
  android:gravity="center_horizontal"
  android:minHeight="72dp"
  android:orientation="vertical"
  android:padding="6dp">
  <FrameLayout
    android:layout_width="30dp"
    android:layout_height="30dp">
    <ImageView
      android:id="@+id/hbots_face_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:src="@drawable/hbots_avatar"/>
    <TextView
      android:id="@+id/hbots_face_text"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:importantForAccessibility="no"
      android:textColor="#FFFFFFFF"
      android:textSize="13sp"
      android:textStyle="bold"/>
  </FrameLayout>
  <TextView
    android:id="@+id/hbots_name"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FFF2F2EF"
    android:textSize="12sp"
    android:layout_marginTop="3dp"/>
  <TextView
    android:id="@+id/hbots_sub"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#FF8C8C88"
    android:textSize="11sp"/>
</LinearLayout>
