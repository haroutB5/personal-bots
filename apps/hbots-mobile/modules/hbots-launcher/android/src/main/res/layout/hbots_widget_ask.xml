<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/hbots_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/hbots_widget_bg"
  android:orientation="horizontal"
  android:padding="8dp"
    android:gravity="center_vertical">
  <TextView
    android:id="@+id/hbots_ask"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/hbots_pill"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:maxLines="1"
    android:minHeight="40dp"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:textColor="#FF8C8C88"
    android:textSize="15sp"/>
  <ImageView
    android:id="@+id/hbots_photo"
    android:layout_width="44dp"
    android:layout_height="match_parent"
    android:layout_marginStart="6dp"
    android:contentDescription="@string/hbots_photo"
    android:padding="10dp"
    android:src="@drawable/hbots_ic_camera"/>
  <ImageView
    android:id="@+id/hbots_voice"
    android:layout_width="44dp"
    android:layout_height="match_parent"
    android:contentDescription="@string/hbots_voice"
    android:padding="10dp"
    android:src="@drawable/hbots_ic_mic"/>
</LinearLayout>
