        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/hbots_usage_info"/>
    </receiver>
    <receiver
      android:name="expo.modules.hbotslauncher.OneBotWidgetProvider"
