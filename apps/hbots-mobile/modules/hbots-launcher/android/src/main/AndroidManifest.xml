    </receiver>
    <receiver
      android:name="expo.modules.hbotslauncher.TodayWidgetProvider"
      android:exported="true"
      android:label="@string/hbots_today_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/hbots_today_info"/>
    </receiver>
  </application>
</manifest>
