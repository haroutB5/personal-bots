<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- No UI. Shortcuts land here and it forwards the link to the running app; see the class comment. -->
    <activity
      android:name="expo.modules.hbotslauncher.ShortcutTrampolineActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:launchMode="standard"
      android:taskAffinity=""
      android:theme="@android:style/Theme.NoDisplay"/>
    <receiver
      android:name="expo.modules.hbotslauncher.HbotsWidgetProvider"
      android:exported="true"
      android:label="@string/hbots_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/hbots_widget_info"/>
    </receiver>
    <receiver
      android:name="expo.modules.hbotslauncher.NeedsYouWidgetProvider"
      android:exported="true"
      android:label="@string/hbots_needs_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/hbots_needs_info"/>
    </receiver>
    <receiver
      android:name="expo.modules.hbotslauncher.TileGridWidgetProvider"
