<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <!-- Never draws an overlay: the grant is what lets the updated app reopen itself after Restart. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <application>
    <receiver android:name="expo.modules.hbotsupdater.UpdateInstallReceiver" android:exported="false"/>
    <receiver android:name="expo.modules.hbotsupdater.UpdateAlarmReceiver" android:exported="false"/>
    <receiver android:name="expo.modules.hbotsupdater.UpdateRestartReceiver" android:exported="false"/>
  </application>
</manifest>
