+          operation: input.operation,
+          model,
+          fallbackModel,
+          detail: error.detail.slice(0, 300),
+        }).pipe(
+          Effect.andThen(
+            // Haiku 4.5 has no effort setting: the retry sends the bare model.
+            runClaudeJsonOnce({
+              ...input,
+              modelSelection: { instanceId: requested.instanceId, model: fallbackModel },
+            }),
+          ),
+        ),
+      ),
+    );
