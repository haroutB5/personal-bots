+  assert.equal(AnalyticsService.retryDelayMs(2, 0.999_999), 4_000);
+  assert.equal(AnalyticsService.retryDelayMs(30, 0), 150_000);
+  assert.equal(AnalyticsService.retryDelayMs(30, 0.999_999), 300_000);
+});
