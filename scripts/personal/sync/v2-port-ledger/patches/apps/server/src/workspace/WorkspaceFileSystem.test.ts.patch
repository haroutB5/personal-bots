+
+          const error = yield* withHost(
+            { home },
+            workspaceFileSystem.readFile({ cwd, relativePath: "harmless.md" }),
+          ).pipe(Effect.flip);
+
+          expect(error).toBeInstanceOf(WorkspaceFileSystem.WorkspaceProtectedFileError);
+        }),
+    );
