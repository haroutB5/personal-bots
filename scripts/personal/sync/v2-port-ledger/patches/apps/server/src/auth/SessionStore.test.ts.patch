+      yield* sessions.verifyWebSocketToken(websocket.token);
+      expect((yield* sessions.listActive()).map((session) => session.sessionId)).toEqual([
+        issued.sessionId,
+      ]);
+    }).pipe(Effect.provide(Layer.merge(makeSessionStoreLayer(), TestClock.layer()))),
