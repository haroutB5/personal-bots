+  const more =
+    rows.length > MAX_PLUGIN_ERRORS_SHOWN
+      ? ` and ${rows.length - MAX_PLUGIN_ERRORS_SHOWN} more`
+      : "";
+  return {
+    text: `A plugin did not load: ${shown.join("; ")}${more}`,
+    plugins: rows.map((row) => `${row.plugin} (${row.type})`),
+  };
