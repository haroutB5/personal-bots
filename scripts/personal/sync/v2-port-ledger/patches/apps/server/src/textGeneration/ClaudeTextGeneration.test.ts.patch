+      inTempDir((dir) =>
+        withEnv(
+          {
+            T3_FAKE_CLAUDE_CALL_LOG: callLogOf(dir),
+            T3_FAKE_CLAUDE_FAIL_MODEL: SYNTHETIC_CLAUDE_STANDARD_MODEL,
