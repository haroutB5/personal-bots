+
+    it.effect("retries once on Haiku 4.5, with no effort flag, when Haiku 5.5 is refused", () =>
+      inTempDir((dir) =>
+        withEnv(
+          { T3_FAKE_CLAUDE_CALL_LOG: callLogOf(dir), T3_FAKE_CLAUDE_FAIL_MODEL: HAIKU_5_5 },
