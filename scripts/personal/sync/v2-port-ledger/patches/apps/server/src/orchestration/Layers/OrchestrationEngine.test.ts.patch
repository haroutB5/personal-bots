+        threadId: ThreadId.make("thread-queue"),
+        message: {
+          messageId: asMessageId("msg-queued"),
+          role: "user",
+          text: "sent from the train",
+          attachments: [],
+        },
+        interactionMode: DEFAULT_PROVIDER_INTERACTION_MODE,
+        runtimeMode: "approval-required",
+        createdAt,
+      }) as const;
+    const countTurnStarts = async () =>
+      (
+        await system.run(
