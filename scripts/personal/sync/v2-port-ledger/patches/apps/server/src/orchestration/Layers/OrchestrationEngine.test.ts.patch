+      engine.dispatch({
+        type: "project.create",
+        commandId: CommandId.make("cmd-queue-project-create"),
+        projectId: asProjectId("project-queue"),
+        title: "Queue Project",
+        workspaceRoot: "/tmp/project-queue",
+        defaultModelSelection: {
+          instanceId: ProviderInstanceId.make("codex"),
+          model: "gpt-5-codex",
