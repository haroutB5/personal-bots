[Unit]
Description=Personal Bots nightly dependency update (gated, binary rollback on failure)

[Service]
Type=oneshot
WorkingDirectory=@REPO@
EnvironmentFile=-%h/.config/hbots/env
ExecStart=@NODE@ @REPO@/scripts/personal/node/hbots.mjs sync --mode updates --apply
TimeoutStartSec=5400
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=default.target
